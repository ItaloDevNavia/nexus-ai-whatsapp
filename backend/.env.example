# Configuración del servidor Backend
PORT=5000

# Google Gemini API Key
# Obtenla en: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo de Gemini (opcional, por defecto: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Meta / WhatsApp Cloud API Configuración
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET= (opcional para validación de firma x-hub-signature-256)
# WHATSAPP_MOCK_SEND=false (establecer en true para simular envíos en tests locales)
